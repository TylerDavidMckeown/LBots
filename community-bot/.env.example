# Lyss Community environment. Copy to .env and fill in. Never commit .env.

# Developer Portal > Bot > Reset Token
DISCORD_TOKEN=
# Developer Portal > General Information > Application ID
CLIENT_ID=
# Server where slash commands are registered (instant updates). Leave empty and use --global otherwise.
GUILD_ID=
# Your Discord user ID. Separate multiple owners with commas.
OWNER_ID=

# Optional: debug | info | warn | error
LOG_LEVEL=info
# Optional: where automatic database backups are written. Default: ../backups
BACKUP_DIR=
